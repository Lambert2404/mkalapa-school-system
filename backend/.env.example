# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (either DATABASE_URL, or the individual DB_* vars below)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mkalapa_db
DB_NAME=mkalapa_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS - frontend origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMS Gateway — NextSMS "Messaging Service API V2"
# Docs: https://documenter.getpostman.com/view/1679195/2sAYkDP1XN
#
# SMS_PROVIDER=mock       -> uses MockSMSProvider, no real SMS sent (default, safe for dev)
# SMS_PROVIDER=nextsms    -> uses NextSMSProvider, requires real credentials below
SMS_PROVIDER=mock

# Auth method: "bearer" (recommended by NextSMS) or "basic"
SMS_AUTH_METHOD=bearer

# Bearer token: Customer Info -> Customization -> API Keys, in the NextSMS dashboard
SMS_ACCESS_TOKEN=

# Basic auth alternative (used only when SMS_AUTH_METHOD=basic)
SMS_API_KEY=
SMS_API_SECRET=

SMS_SENDER_ID=MKALAPA

# NextSMS Test Mode sends dummy responses at no cost — keep True until you
# are ready to send real messages, then set to False for the live endpoint.
SMS_TEST_MODE=True

# Optional override; normally computed automatically from SMS_TEST_MODE.
# Live:  https://messaging-service.co.tz/api/sms/v2/text/single
# Test:  https://messaging-service.co.tz/api/sms/v2/test/text/single
SMS_BASE_URL=

# NEVER commit a real .env file to Git.
